rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedCards']);
    }

    // Admin collection (to store admin roles)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via GCP console/CLI for safety
    }

    // Bets collection
    match /bets/{betId} {
      allow read: if true; // Everyone can see the list (premium content handled via UI blur)
      allow create, update, delete: if isAdmin();
    }

    // MatchStats collection
    match /matchStats/{betId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // BankData collection (PII isolation)
    match /bankData/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
    }

    // Payments collection
    match /payments/{paymentId} {
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
  }
}
